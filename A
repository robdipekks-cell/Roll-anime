-- ==================== NUMBER PARSING UTILITY ==================== --
local function ParseSuffixString(str)
    if type(str) == "number" then return str end
    if not str then return 0 end
    
    -- Clean the string: remove $, commas, spaces, and make lowercase
    str = string.lower(tostring(str))
    str = string.gsub(str, "[$%s,]", "")

    -- Extract numerical part and optional suffix
    local numberPart = string.match(str, "^[%d%.]+")
    local suffixPart = string.match(str, "[a-z]+$")

    if not numberPart then return 0 end
    local num = tonumber(numberPart) or 0

    -- Standard Roblox suffix dictionary
    local Suffixes = {
        k = 1e3, m = 1e6, b = 1e9, t = 1e12, q = 1e15, qd = 1e15, qi = 1e18, 
        sx = 1e21, sp = 1e24, oc = 1e27, no = 1e30, dc = 1e33
    }

    if suffixPart and Suffixes[suffixPart] then
        num = num * Suffixes[suffixPart]
    end

    return num
end

-- ==================== SORTING UTILITY ==================== --
local BlockHierarchy = {
    "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic", "Galaxy", 
    "Quantum", "Ascendant", "Devil", "Heavenly", "Magic", "Bramble", 
    "TimeBender", "Infinity", "KingSun", "Ouroboros", "MoltenCore", 
    "ToxicReactor", "King'sMantle", "TheEnd", "Aetherial", "Radiant", 
    "CelestialEmperor", "Phantom", "Anomaly", "Verca", "Vortex", "BloodCode", 
    "Doom", "Hellcore", "Verdict", "Pinnacle", "Nothing"
}

local BlockRanks = {}
for i, name in ipairs(BlockHierarchy) do
    BlockRanks[name] = i
end

local function SortBlockNames(blockNames)
    table.sort(blockNames, function(a, b)
        local cleanA = string.gsub(a, "Block$", "")
        local cleanB = string.gsub(b, "Block$", "")
        local rankA = BlockRanks[cleanA] or BlockRanks[a] or 999
        local rankB = BlockRanks[cleanB] or BlockRanks[b] or 999
        if rankA == rankB then return a < b end
        return rankA < rankB
    end)
    return blockNames
end

-- ==================== CORE UTILITIES ==================== --
local function GetHighestAvailableBlock()
    local blocksFolder = LocalPlayer:FindFirstChild("Blocks")
    if not blocksFolder then return nil end

    local availableBlocks = {}
    for _, block in pairs(blocksFolder:GetChildren()) do
        if (block:IsA("NumberValue") or block:IsA("IntValue")) and block.Value > 0 then
            table.insert(availableBlocks, block.Name)
        end
    end

    if #availableBlocks == 0 then return nil end

    -- Sort descending (Highest Tier First)
    table.sort(availableBlocks, function(a, b)
        local cleanA = string.gsub(a, "Block$", "")
        local cleanB = string.gsub(b, "Block$", "")
        local rankA = BlockRanks[cleanA] or BlockRanks[a] or 0
        local rankB = BlockRanks[cleanB] or BlockRanks[b] or 0
        return rankA > rankB 
    end)

    return availableBlocks[1] 
end

local function GetMostExpensiveAffordableBlock()
    -- Safely navigate to the ItemShop UI
    local mainGui = LocalPlayer.PlayerGui:FindFirstChild("Main")
    if not mainGui then return nil end
    local frames = mainGui:FindFirstChild("Frames")
    if not frames then return nil end
    local itemShop = frames:FindFirstChild("ItemShop")
    if not itemShop then return nil end
    local scrollingFrame = itemShop:FindFirstChild("ScrollingFrame")
    if not scrollingFrame then return nil end

    -- Parse Player Coins
    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    if not leaderstats or not leaderstats:FindFirstChild("Coins") then return nil end
    local myCoins = ParseSuffixString(leaderstats.Coins.Value)

    local bestBlockName = nil
    local highestPrice = -1

    -- Iterate UI to find highest affordable
    for _, child in pairs(scrollingFrame:GetChildren()) do
        if child:IsA("Frame") or child:IsA("ImageLabel") then
            -- Navigate deep into the button structure
            local buttons = child:FindFirstChild("Buttons")
            if buttons then
                local purchase = buttons:FindFirstChild("Purchase")
                if purchase then
                    local button = purchase:FindFirstChild("Button")
                    if button then
                        local textLabel = button:FindFirstChild("TextLabel")
                        if textLabel then
                            local price = ParseSuffixString(textLabel.Text)
                            
                            if price <= myCoins and price > highestPrice then
                                highestPrice = price
                                bestBlockName = child.Name -- Child name is typically the block name
                            end
                        end
                    end
                end
            end
        end
    end

    return bestBlockName
end

local function GetPlayerPlot()
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return nil end
    for _, plot in pairs(plots:GetChildren()) do
        local owner = plot:FindFirstChild("Owner")
        if owner then
            if typeof(owner.Value) == "Instance" and owner.Value == LocalPlayer then
                return plot
            elseif tostring(owner.Value) == LocalPlayer.Name then
                return plot
            end
        end
    end
    return nil
end

local function GetAnimeSlots()
    local myPlot = GetPlayerPlot()
    local slotList = {}
    local slotMapping = {} 
    
    if myPlot and myPlot:FindFirstChild("Slots") then
        local animeAssets = RS:FindFirstChild("Assets") and RS.Assets:FindFirstChild("AnimeCharacters")
        if animeAssets then
            for _, slot in pairs(myPlot.Slots:GetChildren()) do
                for _, child in pairs(slot:GetChildren()) do
                    if animeAssets:FindFirstChild(child.Name) then
                        local dropdownName = child.Name .. " (Slot " .. slot.Name .. ")"
                        table.insert(slotList, dropdownName)
                        slotMapping[dropdownName] = slot.Name
                    end
                end
            end
        end
    end
    return slotList, slotMapping
end

local function GetStockBlocks()
    local blockNames = {}
    local stockFolder = LocalPlayer:FindFirstChild("Stock")
    if stockFolder then
        for _, block in pairs(stockFolder:GetChildren()) do
            if block:IsA("NumberValue") or block:IsA("IntValue") then
                table.insert(blockNames, block.Name)
            end
        end
    end
    return SortBlockNames(blockNames)
end

local function GetInventoryBlocks()
    local blockNames = {}
    local blocksFolder = LocalPlayer:FindFirstChild("Blocks")
    if blocksFolder then
        for _, block in pairs(blocksFolder:GetChildren()) do
            table.insert(blockNames, block.Name)
        end
    end
    return SortBlockNames(blockNames)
end

