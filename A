-- Safely checks the workspace value against multiple selected events
local function IsEventActive()
    if SelectedEvents["Any"] then return true end -- If "Any" is checked, bypass the check and roll
    
    local success, eventValue = pcall(function() 
        return tostring(workspace._Data.Event.Value) 
    end)
    
    -- Check if we successfully got the event, and if it is currently selected in the multi-dropdown
    if success and eventValue then
        return SelectedEvents[eventValue] == true
    end
    
    return false
end

